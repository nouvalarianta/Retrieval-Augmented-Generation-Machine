# Sensitive environment variables
.env
.env.*
!.env.example

# Company documents (PDF & Excel) strictly blocked from git
docs/*
!docs/.gitkeep
*.pdf
*.xlsx
*.xls
*.db
*.sqlite
*.sqlite3
*.npy
